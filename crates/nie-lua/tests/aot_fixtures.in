    ("math-lib", r#"return math.floor(3.7), math.floor(-3.2), math.ceil(3.2), math.abs(-4), math.max(3,9,2), math.min(3,9,2), math.sqrt(16), math.pi, math.huge, math.fmod(7,3), math.fmod(-7,3), math.floor(2^31+0.5), math.sin(0), math.cos(0), math.atan2(1,1), math.deg(math.pi), math.rad(180), math.pow(2,8), math.log(8,2), math.log10(1000), math.exp(0), select(2, math.modf(3.5)), math.modf(-3.5)"#),
