# mkinitcpio preset file for the 'linux-nie-rc' package
ALL_config="/etc/mkinitcpio.conf"
ALL_kver="/boot/vmlinuz-linux-nie-rc"

PRESETS=('default' 'fallback')

default_image="/boot/initramfs-linux-nie-rc.img"

fallback_image="/boot/initramfs-linux-nie-rc-fallback.img"
fallback_options="-S autodetect"
