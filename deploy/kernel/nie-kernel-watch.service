[Unit]
Description=nie kernel pipeline: watch kernel.org for a new mainline tag, build, boot-test
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Environment=NIE_KERNEL_DIR=/opt/nie-kernel
ExecStart=/usr/local/bin/xtask kernel cycle
TimeoutStartSec=6h
Nice=10
