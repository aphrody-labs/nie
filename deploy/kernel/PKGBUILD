# Maintainer: nie contributors
# Vanilla upstream mainline (release candidate or release) kernel for the nie production host, beside the stock `linux`.
# Inputs come from the environment, set by deploy/kernel/build.sh:
#   NIE_KERNEL_TAG     signed upstream tag, for example v7.4-rc3
#   NIE_KERNEL_SHA256  sha256 of linux.tar, the `git archive` of that tag
# SOURCE_DATE_EPOCH is the tagger time of the tag: it fixes every timestamp of the build.
pkgname=linux-nie-rc
_tag=${NIE_KERNEL_TAG:?NIE_KERNEL_TAG is not set}
_ver=${_tag#v}
pkgver=${_ver/-/}
pkgrel=1
pkgdesc='Vanilla upstream mainline Linux kernel (release candidate) with Rust support, built for nie'
url='https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git'
arch=(x86_64)
license=(GPL-2.0-only)
makedepends=(bc cpio git libelf pahole perl python tar xz zstd kmod inetutils xmlto rust rust-src rust-bindgen clang llvm lld)
options=('!strip' '!debug' '!lto')
source=("linux.tar" prd.config nie-rc.fragment linux-nie-rc.preset)
sha256sums=("${NIE_KERNEL_SHA256:?NIE_KERNEL_SHA256 is not set}" SKIP SKIP SKIP)
noextract=(linux.tar)
_srcname=linux-${_ver}
export KBUILD_BUILD_USER=nie KBUILD_BUILD_HOST=nie-rc KBUILD_BUILD_VERSION=1

prepare() {
  tar -xf linux.tar
  cd "$_srcname"
  echo "Setting config..."
  cp ../prd.config .config
  make olddefconfig
  scripts/kconfig/merge_config.sh -m -O . .config ../nie-rc.fragment
  make olddefconfig
  grep -q '^CONFIG_RUST=y' .config || { echo "CONFIG_RUST is not enabled: $(make -s rustavailable 2>&1)" >&2; exit 1; }
  make -s kernelrelease > version
  echo "Prepared $pkgname version $(<version)"
}

build() {
  cd "$_srcname"
  export KBUILD_BUILD_TIMESTAMP="$(date -u -d "@$SOURCE_DATE_EPOCH")"
  make -j"$(nproc)" all
}

package() {
  pkgdesc="The $pkgdesc kernel and modules"
  depends=(coreutils initramfs kmod)
  optdepends=('linux-firmware: firmware images needed for some devices')
  provides=(WIREGUARD-MODULE)
  cd "$_srcname"
  local modulesdir="$pkgdir/usr/lib/modules/$(<version)"
  echo "Installing boot image..."
  install -Dm644 "$(make -s image_name)" "$modulesdir/vmlinuz"
  echo "$pkgname" | install -Dm644 /dev/stdin "$modulesdir/pkgbase"
  echo "Installing modules..."
  ZSTD_CLEVEL=19 make INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 DEPMOD=/doesnt/exist modules_install
  rm -f "$modulesdir"/{source,build}
  install -Dm644 "$srcdir/prd.config" "$pkgdir/usr/share/$pkgname/prd.config"
  install -Dm644 .config "$pkgdir/usr/share/$pkgname/config"
  install -Dm644 "$srcdir/linux-nie-rc.preset" "$pkgdir/etc/mkinitcpio.d/$pkgname.preset"
}
