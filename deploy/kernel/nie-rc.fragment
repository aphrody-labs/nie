# Applied over the prd config (7.2.14-arch1-1 /proc/config.gz) after `make olddefconfig` on the new tag.
CONFIG_LOCALVERSION="-nie-rc"
# CONFIG_LOCALVERSION_AUTO is not set
# Module signing uses a key generated per build; without it the modules are bit-for-bit reproducible.
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_ALL is not set
# Rust for Linux stays on, as on prd.
CONFIG_RUST=y
