# Updates the game in the Steam library /srv/nie/steam with `nie steam sync` (files already up to
# date are skipped). Credentials: /etc/nie/steam.env (STEAM_USER, STEAM_HOME) and the refresh token
# in $STEAM_HOME/steam-tokens.json. Heavy work waits on the shared prd lock.
[Unit]
Description=nie game update from Steam (app 2799860)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/srv/nie/steam/steam-tokens.json

[Service]
Type=oneshot
EnvironmentFile=/etc/nie/steam.env
Nice=19
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
ExecStart=/usr/bin/flock -w 7200 /var/lock/aphrody-heavy.lock /usr/local/bin/nie steam sync --out "/srv/nie/steam/steamapps/common/INAZUMA ELEVEN Victory Road"
