# nie docker stack on the production host. Installed by deploy/install.sh.
[Unit]
Description=nie stack (docker compose project nie)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
WorkingDirectory=/srv/nie/deploy
EnvironmentFile=/etc/nie/stack.env
ExecStart=/usr/bin/docker compose up --no-build --remove-orphans
ExecStop=/usr/bin/docker compose stop
TimeoutStopSec=60
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
