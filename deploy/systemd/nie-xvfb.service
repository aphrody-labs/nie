# Headless X display :99 with openbox, used by nie-run (nie.exe under Proton). Installed by deploy/install.sh.
[Unit]
Description=nie headless Xvfb (:99) and openbox for nie.exe under Proton
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nie-xvfb
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
