{
  "name": "@rosegriffon/cron",
  "version": "1.4.4",
  "private": false,
  "description": "Tâches planifiées Rose Griffon (maintenance DB, Discord, campagnes, SEO) : registre, route HTTP serverless et CLI",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "bun test src",
    "start": "bun src/index.ts",
    "qa:website": "bun src/index.ts --run website:qa",
    "compile": "bun build src/index.ts --compile --minify --sourcemap --bytecode --format esm --outfile dist/rg-cron",
    "type-check": "bun check -p tsconfig.typecheck.json --noEmit",
    "lint": "oxlint -c ../rg-config/oxlintrc.json src",
    "typecheck": "bun check -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@rosegriffon/config": "workspace:*",
    "@crawlee/cheerio": "catalog:",
    "@crawlee/core": "catalog:",
    "@crawlee/impit-client": "catalog:",
    "@crawlee/playwright": "catalog:",
    "@orama/orama": "catalog:",
    "@rosegriffon/assets": "workspace:*",
    "@rosegriffon/db": "workspace:*",
    "@rosegriffon/inagle": "workspace:*",
    "@rosegriffon/types": "workspace:*",
    "@vercel/functions": "catalog:",
    "cheerio": "catalog:",
    "crawlee": "catalog:",
    "discord.js": "catalog:",
    "impit": "catalog:",
    "patchright": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.5"
  },
  "license": "Apache-2.0",
  "files": [
    ".npmignore",
    "src",
    "tsconfig.json",
    "tsconfig.typecheck.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/rosegriffon.git",
    "directory": "packages/rg-cron"
  },
  "homepage": "https://github.com/aphrody-labs/rosegriffon/tree/main/packages/rg-cron#readme",
  "bugs": {
    "url": "https://github.com/aphrody-labs/rosegriffon/issues"
  }
}
