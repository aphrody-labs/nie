# Rose Griffon docker stack on the prod role host (prd): keeps `docker compose up` running across
# reboots and crashes. Installed by infra/scripts/install-stack-unit.sh (called by `just deploy`).
# /etc/rosegriffon/stack.env holds RG_TAG (written by the deploy, short commit of the loaded images).
[Unit]
Description=Rose Griffon stack (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
WorkingDirectory=/srv/rosegriffon/src
EnvironmentFile=/etc/rosegriffon/stack.env
ExecStart=/usr/bin/docker compose up --no-build --remove-orphans
ExecStop=/usr/bin/docker compose stop
TimeoutStopSec=60
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
