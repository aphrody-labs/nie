{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "rosegriffon-edge",
  "main": "worker.ts",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  // R2 serves cdn.rosegriffon.fr/static/*; prd (Origin Rule, port 8443) is the fallback.
  "routes": [{ "pattern": "cdn.rosegriffon.fr/static/*", "zone_name": "rosegriffon.fr" }],
  "build": {
    "command": "bun build-wasm.ts",
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "CDN_BUCKET",
      "bucket_name": "rosegriffon-cdn",
    },
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
}
