{
  "mcpServers": {
    "rosegriffon": {
      "command": "bun",
      "args": [
        "run",
        "apps/mcp/src/index.ts"
      ]
    },
    "context7": {
      "command": "bunx",
      "args": [
        "@upstash/context7-mcp@latest"
      ]
    },
    "better-auth": {
      "type": "http",
      "url": "https://mcp.better-auth.com/mcp"
    },
    "shadcn": {
      "command": "bunx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "next-devtools": {
      "command": "bunx",
      "args": [
        "next-devtools-mcp@latest"
      ]
    }
  }
}
