#!/bin/sh
# nie-os PID 1: mounts the virtiofs share of the game directory and serves nie on port 8790.
export PATH=/bin HOME=/tmp
mount -t proc none /proc
mount -t sysfs none /sys
grep -q ' /dev ' /proc/mounts || mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /tmp
mkdir -p /game
if mount -t virtiofs nie-game /game; then
  echo "nie-os: virtiofs nie-game mounted on /game: $(ls /game | tr '\n' ' ')"
else
  echo "nie-os: virtiofs mount failed"
fi
export NIE_HOST=0.0.0.0 NIE_PORT=8790 NIE_GAME_SOURCE=/game
echo "nie-os: starting nie serve"
nie serve --strict
echo "nie-os: nie serve exited with $?"
poweroff -f
