  "antigravity_stack": {
    "internal_runtime": {
      "sdk_harness_binary": "localharness",
      "sdk_binary_lookup_order": [
        "env:ANTIGRAVITY_HARNESS_PATH",
        "./bin/localharness",
        "PATH:localharness"
      ],
      "ide_electron_abi": "v140 (Node v22.21.1)",
      "ide_local_ipc": {
        "host": "127.0.0.1",
        "protocol": "ConnectRPC",
        "auth": "ephemeral_per_session_csrf_token",
        "local_state_db": "state.vscdb (SQLite; native better-sqlite3 incompatible with Electron ABI v140)"
      },
      "session_transcripts": {
        "cli": "~/.gemini/antigravity-cli/brain/<session_id>/.system_generated/logs/transcript_full.jsonl",
        "app_ide": "~/.gemini/antigravity/brain/<session_id>/.system_generated/logs/transcript_full.jsonl"
      },
      "gcp_observability_env": {
        "project": "GOOGLE_CLOUD_PROJECT",
        "cloud_logging": "AGY_LOG_EXPORTER=gcp",
        "cloud_trace": "AGY_OTEL_EXPORTER=gcp"
      }
    },
    "cli": {
      "repo": "https://github.com/google-antigravity/antigravity-cli",
      "binary": "agy",
      "install": {
        "unix": "curl -fsSL https://antigravity.google/cli/install.sh | bash",
        "windows_ps": "irm https://antigravity.google/cli/install.ps1 | iex",
        "windows_cmd": "curl -fsSL https://antigravity.google/cli/install.cmd -o install.cmd && install.cmd && del install.cmd"
      },
      "auth": {
        "keyring_oauth": "browser_or_ssh_auto_detect_remote_url",
        "logout": "/logout",
        "headless_requirement": "cached_credentials_required_or_exits_nonzero",
        "gemini_api_key_mode": "~/.gemini/antigravity-cli/settings.json -> {\"modelProvider\":\"gemini\"} + GEMINI_API_KEY",
        "adc_mode": "AGY_ADC_AUTH=true or ~/.gemini/config/config.json userSettings.enableAdc=true"
      },
      "default_mode_v1_5_7_plus": "auto (fallback default; override in settings.json via \"agentMode\": \"\")",
      "headless_contract": {
        "single_shot": "agy -p \"<prompt>\" --output-format text|json|stream-json [--json-schema '<schema>']",
        "bidirectional_ndjson": "agy --input-format stream-json --output-format stream-json",
        "stdin_message_shape": { "event": "user", "message": { "content": "<prompt_text>" } },
        "stdout_event_sequence": ["init", "step_update*", "result"],
        "hard_constraints": [
          "--input-format stream-json requires --output-format stream-json",
          "Do not combine -p with --input-format stream-json (CLI prompt flag is dropped)",
          "Wait for terminal result event before writing next stdin prompt",
          "Unknown --model exits 1 with JSON error envelope"
        ]
      },
      "acp_server": {
        "command": "agy acp [flags]",
        "login": "agy acp --login",
        "transport": "JSON-RPC over stdin/stdout",
        "supported_editors": ["Zed", "JetBrains IDEs", "Android Studio", "Xcode", "VS Code", "custom ACP clients"]
      },
      "untrusted_repo_guard_v1_5_7": "Entries in .agents/plugins.json and .agents/skills.json escaping workspace/repo root via absolute paths, ../, or symlinks are skipped",
      "worktree_isolation_v1_5_7": "Subagent/swarm git worktrees copy staged, unstaged, and untracked changes; non-git workspaces get isolated workspace copy"
    },
    "sdk": {
      "official": {
        "language": "Python",
        "package": "google-antigravity",
        "license": "Apache-2.0",
        "repo": "https://github.com/google-antigravity/antigravity-sdk-python",
        "install_requirement": "pip install google-antigravity (compiled localharness binary only exists in PyPI platform wheels)",
        "default_model": "gemini-3.8-flash ($0.75/$3.75 per 1M through 2026-12-31; $1.50/$7.50 from 2027-01-01)",
        "config_classes": {
          "LocalAgentConfig": ["api_key", "vertex", "project", "location", "system_instructions", "tools", "policies", "hooks", "mcp_servers", "subagents", "workspaces", "capabilities", "response_schema"],
          "LiteRTAgentConfig": {
            "deps": "pip install google-antigravity litert-lm",
            "options": ["model_path (absolute, no ~)", "backend (gpu|npu|cpu)", "enable_speculative_decoding", "cache_dir", "compaction_config"],
            "reference_checkpoint": "litert-community/gemma-4-26B-A4B-it-litert-lm (gemma-4-26B-A4B-it-gpu.litertlm, ~16.8 GB, >=24 GB VRAM/unified RAM recommended)",
            "constraint": "Do not point LocalOpenAIAgentConfig at litert-lm serve; use LiteRTAgentConfig"
          },
          "LocalOpenAIAgentConfig": {
            "targets": ["Ollama", "LM Studio", "vLLM"],
            "options": ["model", ".lightweight() optimization preset"]
          }
        },
        "streaming_properties": ["async for token in response", "response.thoughts", "response.tool_calls"],
        "structured_output": "response_schema accepting pydantic.BaseModel",
        "subagent_orchestration": {
          "modes": ["dynamic_self_clone ('self')", "custom_static_subagent", "hierarchical_nested"],
          "controls": ["max_subagent_depth", "allowed_subagents", "tool allowlist isolation"]
        },
        "hook_decorators": ["@hooks.pre_tool_call_decide", "@hooks.post_tool_call"],
        "policy_primitives": ["google.antigravity.hooks.policy.allow", "deny", "ask_user"],
        "enterprise_vertex_modes": [
          "Express Mode: LocalAgentConfig(vertex=True, api_key='...')",
          "Standard Mode: LocalAgentConfig(vertex=True, project='...', location='us-central1') via ADC"
        ]
      },
