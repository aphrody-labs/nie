    "extensibility_schemas": {
      "rules": {
        "workspace_paths": ["AGENTS.md", "GEMINI.md", ".agents/rules/*.md (flat scan up to repo root)"],
        "global_paths": ["~/.gemini/AGENTS.md", "~/.gemini/GEMINI.md", "~/.gemini/config/AGENTS.md", "~/.gemini/config/GEMINI.md", "~/.gemini/config/rules/*.md"],
        "plugin_path": "~/.gemini/config/plugins/<name>/rules/",
        "frontmatter_required_in_rules_dir": true,
        "frontmatter_forbidden_in_agents_md": true,
        "valid_triggers": ["always_on", "model_decision", "glob", "manual"],
        "frontmatter_keys": {
          "trigger": "required string",
          "description": "required for model_decision; fallback if always_on exceeds budget",
          "globs_or_glob": "required comma-separated string for glob trigger"
        },
        "cli_limitation": "manual (@mention) rules are not supported in Antigravity CLI"
      },
      "mcp": {
        "workspace_path": ".agents/mcp_config.json",
        "global_path": "~/.gemini/config/mcp_config.json",
        "transports": {
          "stdio": "command (+ args, env)",
          "streamable_http": "serverUrl (+ headers, OAuth 2.0)"
        },
        "timeout_seconds": {
          "positive_int": "replaces default limits in seconds",
          "negative_int": "-1 disables timeout limits",
          "zero_or_unset": "keeps defaults"
        },
        "lazy_loading": "Reads /mcp/<server>/<tool>.json on demand and invokes via built-in call_mcp_tool(ServerName, ToolName, Arguments); falls back to eager if schema write to disk fails",
        "permission_patterns": ["mcp(server/tool)", "mcp(server/*)", "mcp(*)"]
      },
      "hooks": {
        "paths": [".agents/hooks.json", "~/.gemini/config/hooks.json", "<plugin_root>/hooks.json"],
        "events_with_matcher_and_nested_hooks_array": ["PreToolUse", "PostToolUse"],
        "events_with_direct_handler_array_no_matcher": ["SessionStart", "PreInvocation", "PostInvocation", "Stop"],
        "parser_failure_mode": "Any extra 'hooks' wrapper on Stop/PreInvocation/PostInvocation crashes Language Server JSON parsing and silently drops the entire hooks.json",
        "ide_dispatch_bug": "IDE v1.107.0 / v2.1.1 (Windows) silently skipped PostToolUse/Stop; upgrade to >= v2.5.5 or validate on CLI"
      },
      "plugins": {
        "workspace_path": ".agents/plugins/<name>/",
        "global_path": "~/.gemini/config/plugins/<name>/",
        "manifest": "plugin.json (UTF-8 BOM fixed in CLI Nov 2026; extension namespace: extensions['com.google.antigravity'])",
        "bundles": ["skills", "mcp_servers", "custom_agents_subagents", "rules", "lifecycle_hooks", "sidecars"],
        "official_marketplace": "@antigravity-plugins-official",
        "cli_commands": [
          "agy plugin validate ./",
          "agy plugin install <name>@antigravity-plugins-official",
          "agy plugin install <github_url_or_local_dir>",
          "agy agents",
          "agy --agent <name>"
        ]
      },
      "sidecars": {
        "supported_surfaces": ["Antigravity App only (not CLI, not standalone IDE)"],
        "config_path": "~/.gemini/config/sidecars/<name>/sidecar.json",
        "enable_path": "~/.gemini/config/config.json -> sidecars.<name>.enabled",
        "runtime_data_path": "~/.gemini/antigravity/sidecar_data/<name>/logs",
        "schema_keys": {
          "process_mode": ["command", "args", "restart_policy (e.g. on-failure)", "description", "display_name"],
          "schedule_mode": ["builtin: 'schedule'", "args: ['<cron_expr>', ...] + agentapi new-conversation|send-message", "description"]
        },
        "tos_constraint": "Consumer plan forbids relaying/wrapping Antigravity via sidecars or agy -p inside third-party coding agents"
      },
      "dynamic_workflows": {
        "slash_command": "/run-workflow",
        "mechanism": "Reads built-in run-workflow skill, generates Python orchestration script, requests user approval (auto-approved in Turbo), executes background phases",
        "agent_parameters": {
          "model": ["inherit", "flash_lite", "flash", "pro"],
          "type_name": ["self", "research", "<custom_subagent>"],
          "workspace": ["inherit", "branch (isolated git worktree)", "share (new working copy sharing repo storage)"]
