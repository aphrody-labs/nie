  "plans": [
    {
      "package": "nie-formats",
      "action": "split",
      "plan": "Extract the generic part into a new framework crate nie-vfs: ByteSource, vfs.rs, vfs_remote (local, SSH, rclone, HTTP), vfs_manifest, preloaded_vfs, game_source (renamed source). The CPK container stays in nie-formats until a second archive consumer exists. Not mechanical: vfs.rs resolves names through cpk_list.cfg.bin."
    },
    {
      "package": "nie-assets",
      "action": "split",
      "plan": "Keep the Bevy AssetSource over a ByteSource in a framework crate; the game:// scheme and CPK resolution stay app code. Depends on the nie-vfs split."
    },
    {
      "package": "nie-cli",
      "action": "split",
      "plan": "Host (clap, plugin registry, MCP bridge, serve skeleton) becomes a framework crate; the IEVR commands move behind plugins. Today main.rs links the game crates directly."
    },
    {
      "package": "nie-ffi",
      "action": "split",
      "plan": "The C ABI layer is generated from crates/nie-abi/contract.json; moving that contract to apps/ievr/ makes nie-ffi a pure generator output. Owned by isolation-devcli (crlib)."
    },
    {
      "package": "nie-edge",
      "action": "promote",
      "plan": "One test literal names a game path and the crate depends on nie-model-serve. Replace the dependency with a route table loaded from nie.toml, then promote."
    },
    {
      "package": "nie-deploy",
      "action": "split",
      "plan": "Move launcher.rs (Steam app id, Proton) to plugins/launcher; install, units and host stay framework."
    },
    {
      "package": "nie-link",
      "action": "split",
      "plan": "steam.rs and the manifest scan of the installation are app code; the paged content-addressed transport is generic once they are separated."
    },
    {
      "package": "nie-render3d",
      "action": "promote",
      "plan": "Renders any GLB. Remove the dev-dependency on nie-formats and the game wording in README and comments, then promote."
    },
    {
      "package": "nie-shell",
      "action": "promote",
      "plan": "Generates the shell contract from a typed source; read the source from the app nie.toml instead of IEVR constants, then promote."
    },
    {
      "package": "nie-lua",
      "action": "keep",
      "plan": "Executes the game's Lua 5.2 bytecode and the nie.exe host ABI; stays app code."
    }
  ]
}
